# ==============================================================================
# Task 2: Data Extraction Bot - Environment Variables
# ==============================================================================

# LLM Provider selection: 'gemini' (Free) or 'mock' (Offline)
# If left blank, the app will default to 'gemini' when key is present, otherwise 'mock'.
LLM_PROVIDER=gemini

# Google Gemini API Key (Get instantly at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
